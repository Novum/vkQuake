#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

// Compute shader for skeletal skinning of MD5 model vertices
// for acceleration structure building.
//
// Input: md5vert_t vertex data, joint matrices
// Output: skinned vec3 positions

layout (buffer_reference, std430) readonly buffer InputVertexBuffer
{
	float data[];
};
layout (buffer_reference, std430) readonly buffer JointMatrixBuffer
{
	float data[];
};

layout (buffer_reference, std430) writeonly buffer OutputBuffer
{
	float data[];
};

layout (push_constant) uniform PushConsts
{
	uvec2 input_address;  // 0
	uvec2 joints_address; // 8
	uvec2 output_address; // 16
	uint  joints_offset0; // 24 - Joint matrix offset for pose 0
	uint  joints_offset1; // 28 - Joint matrix offset for pose 1
	uint  output_offset;  // 32 - Offset in output buffer (in floats)
	uint  num_verts;	  // 36
	float blend_factor;	  // 40
}
push_constants;

mat4x3 MD5_LoadJointMatrix (uint joint_offset)
{
	JointMatrixBuffer joint_mats = JointMatrixBuffer (push_constants.joints_address);
	const uint		  base = joint_offset * 12;
	return mat4x3 (
		joint_mats.data[base + 0], joint_mats.data[base + 4], joint_mats.data[base + 8], joint_mats.data[base + 1], joint_mats.data[base + 5],
		joint_mats.data[base + 9], joint_mats.data[base + 2], joint_mats.data[base + 6], joint_mats.data[base + 10], joint_mats.data[base + 3],
		joint_mats.data[base + 7], joint_mats.data[base + 11]);
}

#include "skinning.inc"

// md5vert_t layout (EIGHT_WEIGHT_SKINNING undefined):
// float xyz[3]             - 12 bytes (offset 0)
// float norm[3]            - 12 bytes (offset 12)
// float st[2]              - 8 bytes  (offset 24)
// byte joint_weights[4]    - 4 bytes  (offset 32)
// byte joint_indices[4]    - 4 bytes  (offset 36)
// float joint_position_x[4] - 16 bytes (offset 40)
// float joint_position_y[4] - 16 bytes (offset 56)
// float joint_position_z[4] - 16 bytes (offset 72)
// Total: 88 bytes = 22 floats
//
// md5vert8_t layout (EIGHT_WEIGHT_SKINNING defined):
// float xyz[3]             - 12 bytes  (offset 0)
// float norm[3]            - 12 bytes  (offset 12)
// float st[2]              - 8 bytes   (offset 24)
// byte joint_weights[8]    - 8 bytes   (offset 32)
// byte joint_indices[8]    - 8 bytes   (offset 40)
// float joint_position_x[8] - 32 bytes  (offset 48)
// float joint_position_y[8] - 32 bytes  (offset 80)
// float joint_position_z[8] - 32 bytes  (offset 112)
// Total: 144 bytes = 36 floats

layout (local_size_x = 64, local_size_y = 1) in;
void main ()
{
	uint vertex_idx = gl_GlobalInvocationID.x;
	if (vertex_idx >= push_constants.num_verts)
		return;

	InputVertexBuffer vertex_data = InputVertexBuffer (push_constants.input_address);
	OutputBuffer	  positions = OutputBuffer (push_constants.output_address);

	uint base = vertex_idx * MD5_VERTEX_STRIDE_FLOATS;

	// Joint weights and indices are packed as bytes in one or two uint32 words.
	uint weights_packed0 = floatBitsToUint (vertex_data.data[base + MD5_JOINT_WEIGHTS0_FLOAT]);
	uint indices_packed0 = floatBitsToUint (vertex_data.data[base + MD5_JOINT_INDICES0_FLOAT]);
#if defined(EIGHT_WEIGHT_SKINNING)
	uint weights_packed1 = floatBitsToUint (vertex_data.data[base + MD5_JOINT_WEIGHTS1_FLOAT]);
	uint indices_packed1 = floatBitsToUint (vertex_data.data[base + MD5_JOINT_INDICES1_FLOAT]);
#endif

	vec4 weights[MD5_INFLUENCE_GROUP_COUNT] = vec4[MD5_INFLUENCE_GROUP_COUNT](
		vec4 (
			float (weights_packed0 & 0xFF), float ((weights_packed0 >> 8) & 0xFF), float ((weights_packed0 >> 16) & 0xFF),
			float ((weights_packed0 >> 24) & 0xFF)) /
			255.0
#if defined(EIGHT_WEIGHT_SKINNING)
		,
		vec4 (
			float (weights_packed1 & 0xFF), float ((weights_packed1 >> 8) & 0xFF), float ((weights_packed1 >> 16) & 0xFF),
			float ((weights_packed1 >> 24) & 0xFF)) /
			255.0
#endif
	);
	MD5_NormalizeJointWeights (weights);

	// Extract joint indices
	uvec4 indices[MD5_INFLUENCE_GROUP_COUNT] = uvec4[MD5_INFLUENCE_GROUP_COUNT](
		uvec4 (indices_packed0 & 0xFF, (indices_packed0 >> 8) & 0xFF, (indices_packed0 >> 16) & 0xFF, (indices_packed0 >> 24) & 0xFF)
#if defined(EIGHT_WEIGHT_SKINNING)
			,
		uvec4 (indices_packed1 & 0xFF, (indices_packed1 >> 8) & 0xFF, (indices_packed1 >> 16) & 0xFF, (indices_packed1 >> 24) & 0xFF)
#endif
	);
	vec4 joint_position_x[MD5_INFLUENCE_GROUP_COUNT];
	vec4 joint_position_y[MD5_INFLUENCE_GROUP_COUNT];
	vec4 joint_position_z[MD5_INFLUENCE_GROUP_COUNT];
	for (int g = 0; g < MD5_INFLUENCE_GROUP_COUNT; ++g)
	{
		uint offset = base + MD5_JOINT_POSITION_X_FLOAT + g * 4;
		joint_position_x[g] = vec4 (vertex_data.data[offset + 0], vertex_data.data[offset + 1], vertex_data.data[offset + 2], vertex_data.data[offset + 3]);
		offset = base + MD5_JOINT_POSITION_Y_FLOAT + g * 4;
		joint_position_y[g] = vec4 (vertex_data.data[offset + 0], vertex_data.data[offset + 1], vertex_data.data[offset + 2], vertex_data.data[offset + 3]);
		offset = base + MD5_JOINT_POSITION_Z_FLOAT + g * 4;
		joint_position_z[g] = vec4 (vertex_data.data[offset + 0], vertex_data.data[offset + 1], vertex_data.data[offset + 2], vertex_data.data[offset + 3]);
	}

	vec4 joint_positions[MD5_INFLUENCE_COUNT];
	MD5_LoadJointPositions (joint_position_x, joint_position_y, joint_position_z, weights, joint_positions);

	// Skin for both animation frames
	vec3 skinned_pos[2] = vec3[2](vec3 (0.0), vec3 (0.0));
	vec3 unused_normals[2] = vec3[2](vec3 (0.0), vec3 (0.0));
	uint joint_offsets[2] = uint[2](push_constants.joints_offset0, push_constants.joints_offset1);

	MD5_SkinFrames (joint_offsets, indices, weights, joint_positions, vec3 (0.0), false, skinned_pos, unused_normals);

	// Interpolate between frames
	vec3 lerped = mix (skinned_pos[0], skinned_pos[1], push_constants.blend_factor);

	// Write output
	uint out_idx = push_constants.output_offset + vertex_idx * 3;
	positions.data[out_idx + 0] = lerped.x;
	positions.data[out_idx + 1] = lerped.y;
	positions.data[out_idx + 2] = lerped.z;
}
